# ROS 2/colcon build outputs
**/build/
**/install/
**/log/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python packaging and test coverage
*.egg-info/
.coverage
htmlcov/

# Runtime logs and local editor/OS files
*.log
.DS_Store
*.swp
*~

# Local test suites created during development; tracked project tests remain tracked.
**/test/
**/tests/
**/test_*.py
**/*_test.py
**/test_*.cpp
**/*_test.cpp
**/test_*.cc
**/*_test.cc

# Regression coverage for the MiR camera message conversion.
!mir_robot/mir_launch_hardware/test/
!mir_robot/mir_launch_hardware/test/test_mir_camera_bridge.py

# Regression coverage for the Qualisys ROS 2 bridge.
!mocap/match_mocap_ros2/test/
!mocap/match_mocap_ros2/test/test_qtm_pose.py
!mocap/match_mocap_ros2/test/test_planar_smoothing.py
!mocap/match_mocap_ros2/test/test_map_transform.py

# Reproducibility coverage for the pinned Ewellix diagnostics patch.
!/tests/
!/tests/test_ewellix_diagnostics_patch.py

# Regression coverage for explicit Cartesian startup and FT calibration.
!mur_robot/mur_control/test/
!mur_robot/mur_control/test/test_wrench_bias.cpp
!mur_robot/mur_control/test/test_moveit_proxy_startup.py

# Regression coverage for calibrated marker frames in the robot description.
!mur_robot/mur_description/test/
!mur_robot/mur_description/test/test_calibrated_markers.py
