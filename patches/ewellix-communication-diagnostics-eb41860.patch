+// SPDX-License-Identifier: BSD-3-Clause
+#ifndef EWELLIX_DRIVER__COMMUNICATION_STATE_HPP_
+#define EWELLIX_DRIVER__COMMUNICATION_STATE_HPP_
+
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace ewellix_driver
+{
+
+// Keeps published state and acquisition metadata coherent across the serial
+// worker and ROS timer. Neither serial I/O nor ROS publication holds this lock.
+template<typename State>
+class CommunicationState
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  enum class Health { OK, ERROR, STALE };
+
+  struct Snapshot
+  {
+    State state{};
+    bool has_sample{false};
+    bool last_cycle_ok{false};
+    double last_success_age_sec{-1.0};
+    uint64_t successful_cycles{0};
+    uint64_t consecutive_failures{0};
+    std::string failure_reason;
+
+    Health health(double stale_after_sec) const
+    {
+      if (!has_sample || last_success_age_sec > stale_after_sec) {
+        return Health::STALE;
+      }
+      return last_cycle_ok ? Health::OK : Health::ERROR;
+    }
+  };
+
+  void recordSuccess(const State & state, Clock::time_point now = Clock::now())
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    latest_.state = state;
+    latest_.has_sample = true;
+    latest_.last_cycle_ok = true;
+    ++latest_.successful_cycles;
+    latest_.consecutive_failures = 0;
+    latest_.failure_reason.clear();
+    last_success_ = now;
+  }
+
+  void recordFailure(const std::string & reason)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    latest_.last_cycle_ok = false;
+    ++latest_.consecutive_failures;
+    latest_.failure_reason = reason;
+  }
+
+  Snapshot snapshot(Clock::time_point now = Clock::now()) const
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto result = latest_;
+    if (result.has_sample) {
+      // A writer may have sampled its clock just after the reader sampled now.
+      result.last_success_age_sec = now >= last_success_ ?
+        std::chrono::duration<double>(now - last_success_).count() : 0.0;
+    }
+    return result;
+  }
+
+private:
+  mutable std::mutex mutex_;
+  Snapshot latest_;
+  Clock::time_point last_success_{};
+};
+
+}  // namespace ewellix_driver
+
+#endif  // EWELLIX_DRIVER__COMMUNICATION_STATE_HPP_
