diff --git a/ewellix_driver/test/test_communication_state.cpp b/ewellix_driver/test/test_communication_state.cpp
new file mode 100644
index 0000000..582b3df
--- /dev/null
+++ b/ewellix_driver/test/test_communication_state.cpp
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+#include "gtest/gtest.h"
+#include "ewellix_driver/ewellix_node/communication_state.hpp"
+
+using Tracker = ewellix_driver::CommunicationState<std::array<uint64_t, 6>>;
+using Health = Tracker::Health;
+using namespace std::chrono_literals;
+
+TEST(CommunicationState, NoSampleIsStale)
+{
+  Tracker tracker;
+  const auto snapshot = tracker.snapshot();
+  EXPECT_FALSE(snapshot.has_sample);
+  EXPECT_FALSE(snapshot.last_cycle_ok);
+  EXPECT_DOUBLE_EQ(snapshot.last_success_age_sec, -1.0);
+  EXPECT_EQ(snapshot.health(2.0), Health::STALE);
+}
+
+TEST(CommunicationState, FailurePreservesSampleAndAgeThenSuccessRecovers)
+{
+  Tracker tracker;
+  const auto acquired = Tracker::Clock::time_point(100s);
+  const std::array<uint64_t, 6> first{{1, 2, 3, 4, 5, 6}};
+  tracker.recordSuccess(first, acquired);
+  EXPECT_EQ(tracker.snapshot(acquired + 100ms).health(2.0), Health::OK);
+
+  tracker.recordFailure("cycle2_failed");
+  tracker.recordFailure("invalid_cycle2_payload_size");
+  auto failed = tracker.snapshot(acquired + 500ms);
+  EXPECT_EQ(failed.state, first);
+  EXPECT_EQ(failed.successful_cycles, 1u);
+  EXPECT_EQ(failed.consecutive_failures, 2u);
+  EXPECT_FALSE(failed.last_cycle_ok);
+  EXPECT_DOUBLE_EQ(failed.last_success_age_sec, 0.5);
+  EXPECT_EQ(failed.health(2.0), Health::ERROR);
+  EXPECT_EQ(failed.failure_reason, "invalid_cycle2_payload_size");
+  EXPECT_EQ(tracker.snapshot(acquired + 3s).health(2.0), Health::STALE);
+
+  const std::array<uint64_t, 6> second{{7, 8, 9, 10, 11, 12}};
+  tracker.recordSuccess(second, acquired + 4s);
+  const auto recovered = tracker.snapshot(acquired + 4100ms);
+  EXPECT_EQ(recovered.state, second);
+  EXPECT_EQ(recovered.successful_cycles, 2u);
+  EXPECT_EQ(recovered.consecutive_failures, 0u);
+  EXPECT_TRUE(recovered.failure_reason.empty());
+  EXPECT_DOUBLE_EQ(recovered.last_success_age_sec, 0.1);
+  EXPECT_EQ(recovered.health(2.0), Health::OK);
+}
+
+TEST(CommunicationState, RepeatedPublicationCannotRefreshStalledAcquisition)
+{
+  Tracker tracker;
+  const auto acquired = Tracker::Clock::time_point(100s);
+  tracker.recordSuccess({{42, 42, 42, 42, 42, 42}}, acquired);
+  // The publishing timer stays alive while the serial thread stalls. No ROS
+  // time is an input, so ROS clock jumps cannot make cached data fresh again.
+  for (int i = 1; i <= 30; ++i) {
+    const auto snapshot = tracker.snapshot(acquired + 100ms * i);
+    EXPECT_DOUBLE_EQ(snapshot.last_success_age_sec, 0.1 * i);
+    EXPECT_EQ(snapshot.successful_cycles, 1u);
+    EXPECT_EQ(snapshot.health(2.0), i <= 20 ? Health::OK : Health::STALE);
+  }
+}
+
+TEST(CommunicationState, ConcurrentSnapshotsKeepStateAndMetadataTogether)
+{
+  Tracker tracker;
+  std::atomic<bool> done{false};
+  std::thread writer([&]() {
+    for (uint64_t n = 1; n <= 20000; ++n) {
+      tracker.recordSuccess({{n, n, n, n, n, n}});
+    }
+    done.store(true);
+  });
+  do {
+    const auto snapshot = tracker.snapshot();
+    if (snapshot.has_sample) {
+      for (const auto value : snapshot.state) {
+        EXPECT_EQ(value, snapshot.successful_cycles);
+      }
+      EXPECT_GE(snapshot.last_success_age_sec, 0.0);
+    }
+  } while (!done.load());
+  writer.join();
+  EXPECT_EQ(tracker.snapshot().successful_cycles, 20000u);
+}
diff --git a/ewellix_driver/test/test_cycle2_data.cpp b/ewellix_driver/test/test_cycle2_data.cpp
new file mode 100644
index 0000000..60cd876
--- /dev/null
+++ b/ewellix_driver/test/test_cycle2_data.cpp
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+#include "gtest/gtest.h"
+#include "ewellix_driver/ewellix_serial/ewellix_serial.hpp"
+
+using Cycle2Data = ewellix_driver::EwellixSerial::Cycle2Data;
+
+namespace
+{
+void set32(std::vector<uint8_t> & data, size_t offset, uint32_t value)
+{
+  for (size_t i = 0; i < 4; ++i) {
+    data.at(offset + i) = static_cast<uint8_t>(value >> (8 * i));
+  }
+}
+
+void set16(std::vector<uint8_t> & data, size_t offset, uint16_t value)
+{
+  data.at(offset) = static_cast<uint8_t>(value);
+  data.at(offset + 1) = static_cast<uint8_t>(value >> 8);
+}
+}  // namespace
+
+TEST(Cycle2Data, DecodesAllActuatorsAndExactlyFiveErrorRecords)
+{
+  std::vector<uint8_t> data(98, 0);
+  for (size_t i = 0; i < 6; ++i) {
+    set32(data, i * 4, static_cast<uint32_t>(-100 - static_cast<int>(i)));
+    set32(data, 24 + i * 4, 200 + i);
+    set16(data, 48 + i * 2, 300 + i);
+    set16(data, 60 + i * 2, 400 + i);
+    data.at(72 + i) = static_cast<uint8_t>(i);
+  }
+  for (size_t i = 0; i < 5; ++i) {
+    set32(data, 78 + i * 4, 1u << i);
+  }
+  const Cycle2Data state(data);
+  ASSERT_EQ(state.errors.size(), 5u);
+  for (size_t i = 0; i < 6; ++i) {
+    EXPECT_EQ(state.actual_positions.at(i), -100 - static_cast<int>(i));
+    EXPECT_EQ(state.remote_positions.at(i), 200 + static_cast<int>(i));
+    EXPECT_EQ(state.speeds.at(i), 300 + i);
+    EXPECT_EQ(state.currents.at(i), 400 + i);
+    EXPECT_EQ(state.status.at(i).code, i);
+  }
+  for (size_t i = 0; i < 5; ++i) {
+    EXPECT_EQ(state.errors.at(i).code, 1u << i);
+  }
+}
+
+TEST(Cycle2Data, RejectsMalformedFramesBeforeChangingTheLastValidState)
+{
+  std::vector<uint8_t> valid(98, 0);
+  set32(valid, 0, 1234);
+  Cycle2Data state(valid);
+  for (const size_t size : {0u, 14u, 78u, 97u, 99u, 102u}) {
+    std::vector<uint8_t> invalid(size, 0);
+    EXPECT_THROW(state.setFromData(invalid), std::invalid_argument);
+    EXPECT_THROW((void)Cycle2Data(invalid), std::invalid_argument);
+    EXPECT_EQ(state.actual_positions.at(0), 1234);
+    EXPECT_EQ(state.errors.size(), 5u);
+  }
+  EXPECT_EQ(Cycle2Data().errors.size(), 5u);
+}
