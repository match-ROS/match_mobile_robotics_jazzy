<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

	<xacro:include filename="$(find mir_description)/urdf/general/common_properties.urdf.xacro" />

	<xacro:property name="laser_x" value="0.156" />
	<xacro:property name="laser_y" value="0.155" />
	<xacro:property name="laser_z" value="0.185" />
	<xacro:property name="laser_mass" value="2.0" />

	<xacro:macro name="sick_s300" params="link topic use_simple_collisions:=false use_simple_visuals:=false">
		<link name="${link}">
			<xacro:if value="${use_simple_visuals}">
				<visual>
					<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
					<geometry>
						<box size="${laser_x} ${laser_y} ${laser_z}"/>
					</geometry>
					<xacro:insert_block name="material_black" />
				</visual>
			</xacro:if>
			<xacro:unless value="${use_simple_visuals}">
				<visual>
					<origin xyz="0.0 0.0 0.0" rpy="${pi} 0 0" />
					<geometry>
						<mesh filename="package://mir_description/meshes/visual/sick_lms-100.stl" />
					</geometry>
					<!-- <xacro:insert_block name="material_yellow" /> -->
					<xacro:insert_block name="material_black" />
				</visual>
			</xacro:unless>
			<xacro:if value="${use_simple_collisions}">
				<collision>
					<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
					<geometry>
						<box size="${laser_x} ${laser_y} ${laser_z}"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:unless value="${use_simple_collisions}">
				<collision>
					<origin xyz="0.0 0.0 0.0" rpy="${pi} 0 0" />
					<geometry>
						<mesh filename="package://mir_description/meshes/visual/sick_lms-100.stl" />
					</geometry>
				</collision>
			</xacro:unless>
			<xacro:box_inertial x="${laser_x}" y="${laser_y}" z="${laser_z}" mass="${laser_mass}">
				<origin xyz="0 0 0" />
			</xacro:box_inertial>
		</link>
	</xacro:macro>
</robot>
